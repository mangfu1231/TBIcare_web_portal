<!DOCTYPE html>
<html>
    <head>
    <title>UTSW TBI Care</title>
    <meta charset="utf-8">
    <%- include('partials/header.ejs') %>
    <%- include('partials/table.ejs') %>
    <style>
    .mybutton {
        background-color: Transparent;
        background-repeat:no-repeat;
        border: none;
        cursor:pointer;
        overflow: hidden;
        outline:none;
    }
    </style>
    <style>
        @media screen and (max-width: 1000px) {
            #div_filter {
                height: 160px;
            }
        }

        @media screen and (min-width: 1000px) {
            #div_filter {
                height: 80px;
            }
        }
    </style>
    <script src="/public/js/authentication.js"></script>

    </head>
<body>

<%- include('partials/nav_dashboard.ejs') %>
<%- include('partials/sidebar.ejs') %>
<div id="content"  style="background-color:rgb(233, 231, 231);">
    <div id="mytable" class="col-12 mx-5 form my-5" style="background-color:white;">
  <h1 class="font-family: 'Merriweather', serif;
   text-center">View Heart Rates Variablity</h1>
  <hr>


<div class="container">
    <div id="div_filter" class="jumbotron" style="padding:20px 5px 60px 5px; height:130px;">
        <form action="/website/heart_rate_variability" method="GET">
            <div class="row">
            <div class="form-group col-md-4 col-xs-12">
                <label class="col-md-5 col-xs-12">Patient</label>
                <div class="col-md-7 col-xs-12">
                    <select name="patient_id" id="patient_id" class="form-control">
                        <option value="all" <%= locals.patient_id && locals.patient_id == 'all' ? 'selected' : '' %>>
                            All
                        </option>
                        <% for(var i = 0; i < patients.length; ++i) { %>
                        <option value="<%= patients[i].id %>"
                            <%= locals.patient_id && locals.patient_id == patients[i].id ? 'selected' : '' %>>
                            <%= patients[i].name %>
                        </option> <% } %>
                    </select>
                </div>
            </div>
            <div class="form-group col-md-2 col-xs-12" style='margin-top: 2.7%;'>
                <input type="submit" name="filter" id="filter" value="Filter"
                    class="col-md-12 col-xs-12 btn btn-primary">
            </div>
        </div>
        </form>
    </div>
</div>

<div class="clearfix"></div>
<br>

<div style="text-align:center; width: 100%;">
    <div class="clearfix"></div>
    <br>
    <div class="table-responsive">
        <table id="datatable_data" class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Patient</th>
                    <th>Heart Rate Variability Value</th>
                    <th>Recorded At</th>
                    <th>Created At</th>
                </tr>
            </thead>
            <tbody>

            </tbody>
            <tfoot>
                <tr>
                    <th>ID</th>
                    <th>Patient</th>
                    <th>Heart Rate Variability Value</th>
                    <th>Recorded At</th>
                    <th>Created At</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<% include ./styles_import %>

<script>
    var data = [];
</script>

<% for (var i = 0; i < locals.results.length; ++i) { %>
<script>
    var row = [];
    row.push('<%= results[i].id %>');
    row.push('<%= results[i].patient_name %>');
    row.push('<%= results[i].value %>');
    row.push('<%= results[i].recorded_at %>');
    row.push('<%= results[i].created_at %>');
    data.push(row);
</script>
<% } %>

<script>
    $("#datatable_data").DataTable({
        data: data,
        dom: "Blfrtip",
        "autoWidth": false,
        buttons: [
            {
                extend: "copy",
                className: "btn-sm"
            },
            {
                extend: "csv",
                className: "btn-sm"
            },
            {
                extend: "excel",
                className: "btn-sm"
            },
            {
                extend: "pdfHtml5",
                className: "btn-sm"
            },
            {
                extend: "print",
                className: "btn-sm"
            },
        ],
        responsive: true,
        'order': [[0, 'asc']]
    });
</script>
<%- include('partials/footer.ejs') %>
</body>
</html>