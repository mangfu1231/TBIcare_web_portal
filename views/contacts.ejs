<!DOCTYPE html>
<html>
    <head>
    <title>UTSW TBI Care</title>
    <meta charset="utf-8">
    <%- include('partials/header.ejs') %>
    <%- include('partials/table.ejs') %>
    <style>
    .mybutton {
        background-color: Transparent;
        background-repeat:no-repeat;
        border: none;
        cursor:pointer;
        overflow: hidden;
        outline:none;
    }
    </style>

    <style>
        @media screen and (max-width: 1000px) {
            #div_filter {
                height: 160px;
            }
        }

        @media screen and (min-width: 1000px) {
            #div_filter {
                height: 80px;
            }
        }
    </style>

    <script src="/public/js/authentication.js"></script>

    </head>
<body>

<%- include('partials/nav_dashboard.ejs') %>
<%- include('partials/sidebar.ejs') %>
<div id="content"  style="background-color:rgb(233, 231, 231);">
    <div id="mytable" class="col-12 mx-5 form my-5" style="background-color:white;">
  <h1 class="font-family: 'Merriweather', serif;
   text-center">View Contact</h1>
  <hr>


  <div class="container">
    <div id="div_filter" class="jumbotron" style="padding:20px 5px 100px 5px;">
      <form action="/website/contacts" method="GET">
        <div class="row">
          <div class="form-group col-md-4 col-xs-12">
            <label class="col-md-5 col-xs-12">Type</label>
            <div class="col-md-10 col-xs-12">
              <select name="type" id="type" class="form-control">
                <option value="all" <%= locals.type && locals.type == 'all' ? 'selected' : '' %>>
                  All
                </option>
                <% for(var i = 0; i < locals.contact_types.length; ++i) { %>
                <option value="<%= locals.contact_types[i].id %>"
                  <%= locals.type && locals.type == locals.contact_types[i].id ? 'selected' : '' %>>
                  <%= locals.contact_types[i].english %>
                </option>
                  <% } %>
              </select>
            </div>
          </div>
          <div class="form-group col-md-2 col-xs-12" style="margin: 33px 15px 0px 15px">
            <input type="submit" name="filter" id="filter" value="Filter" class="col-md-12 col-xs-12 btn btn-primary">
          </div>
        </div>
      </form>
  </div>
</div>

<div class="clearfix"></div>
<br>

<div style="text-align:center; width: 100%;">
  <div class="clearfix"></div>
  <br>
  <div class="table-responsive">
      <table id="datatable_data" class="table table-bordered table-striped">
          <thead>
              <tr>
                  <th>ID</th>
                  <th>Name</th>
                  <th>Relation</th>
                  <th>Type</th>
                  <th>Contact Items</th>
                  <th>Color</th>
                  <th>Image URL</th>
                  <th>Created At</th>
                  <th>Edit</th>
                  <th>Delete</th>
              </tr>
          </thead>
          <tbody>

          </tbody>
          <tfoot>
              <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Relation</th>
                <th>Type</th>
                <th>Contact Items</th>
                <th>Color</th>
                <th>Image URL</th>
                <th>Created At</th>
                <th>Edit</th>
                <th>Delete</th>
              </tr>
          </tfoot>
      </table>
  </div>
</div>

<% include ./styles_import %>

<script>
    var data = [];
</script>

<% for (var i = 0; i < contacts.length; ++i) { %>
  <script>
      var row = [];
      row.push('<%= contacts[i].id %>');
      row.push('<%= contacts[i].name %>');
      row.push('<%= contacts[i].relation %>');
      row.push('<%= contacts[i].contact_type %>');
      row.push(`
      <% for(var j = 0; j < contacts[i].contact_items.length; ++j) { %>
          <% if(j) { %> <hr/> <% } %>
          <b>ID:</b> <%= contacts[i].contact_items[j].id %> <br/>
          <b>Type:</b> <%= contacts[i].contact_items[j].type %> <br/>
          <b>Value:</b> <%= contacts[i].contact_items[j].value %>
      <% } %>
      `);
      row.push(`
          <div style="margin-left:auto; margin-right:auto; margin-bottom: 0px; height:20px; width:20px; background-color:<%= contacts[i].color %>"></div>
      `);
      row.push('<%= contacts[i].image_url %>');
      row.push('<div style="margin-left:auto; margin-right:auto; margin-bottom: 0px; height:20px; width:120px; >"><%= contacts[i].created_at %></div>');
      row.push(`<div style="margin-left:auto; margin-right:auto; margin-bottom: 0px; height:20px; width:80px; >"><a style='width:70px' href="/website/contacts/form?contact_id=<%= contacts[i].id %>" target="_blank" class="btn btn-primary">Edit</a></div>`);
      row.push(`<div style="margin-left:auto; margin-right:auto; margin-bottom: 0px; height:20px; width:80px; >"><button class="btn btn-danger" title="Delete" onclick="delete_contact(<%= contacts[i].id %>)">Delete</button></div>`);
      data.push(row);
  </script>
  <% } %>

<script>
  function delete_contact(contact_id) {
      if (confirm("Are you sure you want to delete this contact?")) {
          $("#div_spinner_" + contact_id).css('display', '');
          $("#div_edit_" + contact_id).css('display', 'none');
          $.ajax({
              headers: { "x-csrf-token": "<%= locals.csrfToken %>" },
              url: '/website/contacts/delete',
              type: 'POST',
              dataType: 'text',
              data: { contact_id: contact_id }
          }).done(function (response) {
              console.log(response);
              location.reload();
          }).fail(function (jqXHR, statusText, errorThrown) {
              console.log('error');
              var data = JSON.parse(jqXHR.responseText);
              console.log(data);
              $("#div_spinner_" + contact_id).css('display', 'none');
              $("#div_edit_" + contact_id).css('display', '');
              alert(data.error);
          });
      }
  }
</script>

<script>
  $("#datatable_data").DataTable({
      data: data,
      dom: "Blfrtip",
      "autoWidth": false,
      buttons: [
          {
              extend: "copy",
              className: "btn-sm"
          },
          {
              extend: "csv",
              className: "btn-sm"
          },
          {
              extend: "excel",
              className: "btn-sm"
          },
          {
              extend: "pdfHtml5",
              className: "btn-sm"
          },
          {
              extend: "print",
              className: "btn-sm"
          },
      ],
      responsive: true,
      'order': [[0, 'asc']]
  });
</script>

<%- include('partials/footer.ejs') %>

</body>
</html>