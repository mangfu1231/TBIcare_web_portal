<script>
    $(".remove_empty_option").on('change', function () {
        if ($(this).find("option:first-child").val() == 'empty') {
            $(this).find('option').get(0).remove();
        }
    });
</script>

<script>
    function check() {
        var care_team = document.getElementById('care_team').value;
        if (care_team == 'empty') {
            alert('You missed mandatory fields');
            return false;
        }
        return true;
    }
</script>
<%- include('partials/footer.ejs') %>
</body>
</html>