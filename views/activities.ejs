<!DOCTYPE html>
<html>
    <head>
    <title>UTSW TBI Care</title>
    <meta charset="utf-8">
    <%- include('partials/header.ejs') %>
    <%- include('partials/table.ejs') %>
    <style>
    .mybutton {
        background-color: Transparent;
        background-repeat:no-repeat;
        border: none;
        cursor:pointer;
        overflow: hidden;
        outline:none;
    }
    </style>
    <script src="/public/js/authentication.js"></script>

    </head>
<body>

<%- include('partials/nav_dashboard.ejs') %>
<%- include('partials/sidebar.ejs') %>


<div id="content"  style="background-color:rgb(233, 231, 231);">
  <div id="mytable" class="col-12 mx-5 form my-5" style="background-color:white;">
<h1 class="font-family: 'Merriweather', serif;
 text-center">View Prescription</h1>
<hr>

<!-- Active Archive Selection Function -->
<div id="div_filter" class="jumbotron" style="padding:20px 5px 60px 5px; height:75px">
  <form action="/website/activities" method="GET">
    <div class="row">

      <label class="col-md-2 col-xs-12" style='margin-right: -6%; margin-top:9px; margin-left:3px;'><b>Prescription Status: </b></label>

      <div class="form-group col-md-3 col-xs-12" style='margin-right: -10%;'>
        <div class="col-md-7 col-xs-12" >
          <select name="deleted" id="deleted" class="form-control">
            <option value="0" <%= locals.deleted && locals.deleted == 0 ? 'selected' : '' %>>
              Active
            </option>
            <option value="1" <%= locals.deleted && locals.deleted == 1 ? 'selected' : '' %>>
              Archived
            </option>
          </select>
        </div>
      </div>

      <div class="form-group col-md-1 col-xs-12" >
        <input type="submit" name="filter" id="filter" value="Confirm" class="col-md-12 col-xs-12 btn btn-primary">
      </div>

    </div>
  </form>
</div>

<!-- form start here -->
<div class="table-responsive" style="zoom:70%">

<table 
    id="table"
    style="position: relative; width:99%"
    class="table table-striped"
    data-toggle="table"
    data-pagination="true"
    data-search="true"
    data-show-export="true"
    data-search-align="left"
    data-height="950"
    data-show-toggle="true"
    data-show-columns="true"
    data-show-columns-toggle-all="true"
    data-icon-size = "lg"
    data-sort-class="table-active"
    data-sortable="true"
    data-show-footer="true"
    data-detail-view="true"
    data-click-to-select="true"
    data-detail-formatter="detailFormatter"
    data-minimum-count-columns="2"
    data-page-list="[10, 25, 50, 100, all]"
    data-pagination="true"
    data-page-number="1"
    >
    <thead style="width: auto !important;" id = "mythead" class="black white-text thead-dark">
        <tr>
            <th style="width: 3%" data-field="edit">Edit</th>
            <th style="width: 3%" data-field="ID">ID</th>
            <th data-field="Patient" data-sortable = "true">Patient</th>
            <th data-field="Start Date" data-sortable = "true">Start Date</th>
            <th data-field="End Date" data-sortable = "true">End Date</th>
            <th data-field="Title" data-sortable = "true">Title</th>
            <th data-field="Text" data-sortable = "true">Text</th>
            <th  data-field="Instructions" >Instructions</th>
            <th data-field="Schedule" data-sortable = "true">Schedule</th>
            <th data-field="Target Heart Rate" data-sortable = "true">Target Heart Rate</th>
            <th data-field="Target Steps" data-sortable = "true">Target Steps</th>
            <th class="col-sm-3" data-field="Target Distance" data-sortable = "true">Target Distance</th>
            <th data-field="Target Time" data-sortable = "true">Target Time</th>
            <th data-field="Target Active Burned Energy" data-sortable = "true">Target Burned Energy</th>
            <th data-field="Summary" data-sortable = "true">Summary</th>
            <th data-field="Created At" data-sortable = "true">Created At</th>
            <th data-field="delete"><%= locals.deleted && locals.deleted == 1 ? 'Recover' : 'Archive' %></th>
        </tr>
    </thead>
    <tbody>
        
    </tbody>
    <tfoot >
      <tr>
        <td>Edit</td>
        <td>ID</td>
        <td>Patient</td>
        <td>Start Date</td>
        <td>End Date</td>
        <td>Title</td>
        <td>Text</td>
        <td>Instructions</td>
        <td>Schedule</td>
        <td>Target Heart Rate</td>
        <td>Target Steps</td>
        <td>Target Distance</td>
        <td>Target Time</td>
        <td>Target Burned Energy</td>
        <td>Summary</td>
        <td>Created At</td>
        <td><%= locals.deleted && locals.deleted == 1 ? 'Recover' : 'Archive' %></td>
      </tr>
    </tfoot>
</table>
</div>

<!-- colse side bar -->
</div>
<!-- give data to table -->

<script>
  var data =[];
</script>
<% for (var i = 0; i < activities.length; ++i) { %>
    <script>
        var remove = '<%= locals.deleted %>';
        var obj = {};
        obj["ID"] = '<%= activities[i].id %>';
        obj["Patient"] = '<%= activities[i].patient_name %>';
        obj["Start Date"] = '<%= activities[i].start_date %>';
        obj["End Date"] = '<%= activities[i].end_date %>';
        obj["Group ID"] = '<%= activities[i].group_id %>';
        obj["Type"] = '<%= activities[i].type %>';
        obj["Sub Type"] = '<%= activities[i].subtype %>';
        obj["Workout Type"] = `<% if(activities[i].workout_type_apple_id) { %>
                                  <span><b>Name:</b> <%= activities[i].workout_type_name %></span><br/>
                                  <span><b>Category:</b> <%= activities[i].workout_type_category %></span><br/>
                              <% } %>`;
        obj["Location Type"] = '<%= activities[i].location_type %>';
        obj["Title"] = '<%= activities[i].title %>';
        obj["Text"] = '<%= activities[i].text %>';
        obj["Instructions"] = '<%= activities[i].instructions %>';
        obj["Image URL"] = '<a href = <%= activities[i].image_url %>"><%= activities[i].image_url %><a>';
        obj["Color"] = '<span style=" color: black height:30px; width:400px; background-color:<%= activities[i].color %>"><%= activities[i].color %></span>';
        obj["Result Resettable"] = '<%= activities[i].result_resettable %>';
        obj["Schedule"] = ` <span><b>Type:</b> <%= activities[i].schedule.type %></span><br>
                            <span><b>Frequency:</b> <%= activities[i].schedule.frequency %></span><br>
                            <span><b>Skips:</b> <%= activities[i].schedule.skips %></span>`;
        obj["Optional"] = '<%= activities[i].optional %>';
        obj["Target Heart Rate"] = '<%= activities[i].target_heart_rate %>';
        obj["Target Steps"] = '<%= activities[i].target_steps %>';
        obj["Target Distance"] = '<%= activities[i].target_distance %>';
        obj["Target Time"] = '<%= Math.round(((activities[i].target_time)/60) * 10) / 10 %>';
        obj["Target Active Burned Energy"] = '<%= activities[i].target_active_burned_energy %>';
        obj["Summary"] = '<%= activities[i].summary %>';
        obj["Created At"] = '<%= activities[i].created_at %>';

        if (remove == '1') {
        obj["delete"] = 
        `<button class="mybutton" title="Delete" onclick="recover_activity(<%= activities[i].id %>)">
          <i class="fas fa-redo" style="color: #118f03;"></i>
         </button>`;
        } else {
        obj["delete"] = 
         `<button class="mybutton" title="Delete" onclick="delete_activity(<%= activities[i].id %>)">
          <i class="fas fa-trash-alt" style="color: #ab150a;"></i>
         </button>`;
        };
        
         obj["edit"] = '<a title="Edit"  href="/website/activities/form?activity_id=<%= activities[i].id %>"><i class="fas fa-edit"></i></a>';
        data.push(obj);
    </script>
<% } %>
<script>

var $table = $('#table');
$table.bootstrapTable({data: data})


// undefinedText
$table.bootstrapTable({
  undefinedText: 'N/A',
  data: data
})
// detail Formatter
function detailFormatter(index, row) {
  var html = []
  $.each(row, function (key, value) {
    html.push('<p><b>' + key + ':</b> ' + value + '</p>')
  })
  var newarr = html.slice(0,-2);
  return newarr.join('')
}
</script>

<!-- DELETE DATA -->
<script>
  function delete_activity(activity_id) {
    Swal.fire({
        title: 'Are you sure?',
        
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Yes, delete it!'
      }).then((result) => {
        if (result.value) {
          Swal.fire(
            'Deleted!',
            'Your file has been deleted.',
            'success'
          ).then(function () {
            $("#div_spinner_" + activity_id).css('display', '');
            $("#div_edit_" + activity_id).css('display', 'none');
            $.ajax({
                headers:{"x-csrf-token": "<%= locals.csrfToken %>" },
                url: '/website/activities/delete',
                type: 'POST',
                dataType: 'text',
                data: { activity_id: activity_id }
            }).done(function (response) {
                console.log(response);
                location.reload();
            }).fail(function (jqXHR, statusText, errorThrown) {
                console.log('error');
                var data = JSON.parse(jqXHR.responseText);
                console.log(data);
                $("#div_spinner_" + activity_id).css('display', 'none');
                $("#div_edit_" + activity_id).css('display', '');
                alert(data.error);
            });
        });
      }
    })
  }
</script>

<!-- DELETE DATA -->
<script>
  function recover_activity(activity_id) {
    Swal.fire({
        title: 'Are you sure?',
        
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Yes, recover it!'
      }).then((result) => {
        if (result.value) {
          Swal.fire(
            'Deleted!',
            'Your file has been recovered.',
            'success'
          ).then(function () {
            $("#div_spinner_" + activity_id).css('display', '');
            $("#div_edit_" + activity_id).css('display', 'none');
            $.ajax({
                headers:{"x-csrf-token": "<%= locals.csrfToken %>" },
                url: '/website/activities/recover',
                type: 'POST',
                dataType: 'text',
                data: { activity_id: activity_id }
            }).done(function (response) {
                console.log(response);
                location.reload();
            }).fail(function (jqXHR, statusText, errorThrown) {
                console.log('error');
                var data = JSON.parse(jqXHR.responseText);
                console.log(data);
                $("#div_spinner_" + activity_id).css('display', 'none');
                $("#div_edit_" + activity_id).css('display', '');
                alert(data.error);
            });
        });
      }
    })
  }
</script>


<% include('partials/tableFormatEnd.ejs') %>

<%- include('partials/footer.ejs') %>
</body>
</html>
