<!DOCTYPE html>
<html>
    <head>
    <title>UTSW TBI Care</title>
    <meta charset="utf-8">
    <%- include('partials/header.ejs') %>
    <%- include('partials/table.ejs') %>
    <style>
    .mybutton {
        background-color: Transparent;
        background-repeat:no-repeat;
        border: none;
        cursor:pointer;
        overflow: hidden;
        outline:none;
    }
    </style>

    <style>
        @media screen and (max-width: 1000px) {
            #div_filter {
                height: 160px;
            }
        }

        @media screen and (min-width: 1000px) {
            #div_filter {
                height: 80px;
            }
        }
    </style>

    <script src="/public/js/authentication.js"></script>

    </head>
<body>

<%- include('partials/nav_dashboard.ejs') %>
<%- include('partials/sidebar.ejs') %>
<div id="content"  style="background-color:rgb(233, 231, 231);">
    <div id="mytable" class="col-12 mx-5 form my-5" style="background-color:white;">
  <h1 class="font-family: 'Merriweather', serif;
   text-center">View Contact Items</h1>
  <hr>

<div class="container">
    <div id="div_filter" class="jumbotron" style="padding:20px 5px 100px 5px;">
        <form action="/website/contacts_info" method="GET">
            <div class="row">
                <div class="form-group col-md-4 col-xs-12">
                    <label class="col-md-5 col-xs-12">Type</label>
                    <div class="col-md-10 col-xs-12">
                        <select name="type" id="type" class="form-control">
                            <option value="all" <%= locals.type && locals.type == 'all' ? 'selected' : '' %>>
                                All
                            </option>
                            <option value="Phone" <%= locals.type && locals.type == 'Phone' ? 'selected' : '' %>>
                                Phone
                            </option>
                            <option value="SMS" <%= locals.type && locals.type == 'SMS' ? 'selected' : '' %>>
                                SMS
                            </option>
                            <option value="Email" <%= locals.type && locals.type == 'Email' ? 'selected' : '' %>>
                                Email
                            </option>
                        </select>
                    </div>
                </div>
                <div class="form-group col-md-2 col-xs-12" style="margin: 33px 15px 0px 15px">
                    <input type="submit" name="filter" id="filter" value="Filter"
                        class="col-md-12 col-xs-12 btn btn-primary">
                </div>
            </div>  
        </form>
    </div>
</div>

<div class="clearfix"></div>
<br>

<div style="text-align:center; width: 100%;">
    <div class="clearfix"></div>
    <br>
    <div class="table-responsive">
        <table id="datatable_data" class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Type</th>
                    <th>Value</th>
                    <th>Created At</th>
                    <th>Edit</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>

            </tbody>
            <tfoot>
                <tr>
                    <th>ID</th>
                    <th>Type</th>
                    <th>Value</th>
                    <th>Created At</th>
                    <th>Edit</th>
                    <th>Delete</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<% include ./styles_import %>

<script>
    var data = [];
</script>

<% for (var i = 0; i < contacts_info.length; ++i) { %>
<script>
    var row = [];
    row.push('<%= contacts_info[i].id %>');
    row.push('<%= contacts_info[i].type %>');
    row.push('<%= contacts_info[i].value %>');
    row.push('<%= contacts_info[i].created_at %>');
    row.push(`<div style="margin-left:auto; margin-right:auto; margin-bottom: 0px; width:80px; >"><a style='width:70px' href="/website/contacts_info/form?contacts_info_id=<%= contacts_info[i].id %>" target="_blank" class="btn btn-primary">Edit</a></div>`);
    row.push(`<div style="margin-left:auto; margin-right:auto; margin-bottom: 0px; width:80px; >"><button class="btn btn-danger" title="Delete" onclick="delete_contacts_info(<%= contacts_info[i].id %>)">Delete</button></div>`);
    data.push(row);
</script>
<% } %>

<script>
    function delete_contacts_info(contacts_info_id) {
        if (confirm("Are you sure you want to delete him?")) {
            $("#div_spinner_" + contacts_info_id).css('display', '');
            $("#div_edit_" + contacts_info_id).css('display', 'none');
            $.ajax({
                headers: { "x-csrf-token": "<%= locals.csrfToken %>" },
                url: '/website/contacts_info/delete',
                type: 'POST',
                dataType: 'text',
                data: { contacts_info_id: contacts_info_id }
            }).done(function (response) {
                console.log(response);
                location.reload();
            }).fail(function (jqXHR, statusText, errorThrown) {
                console.log('error');
                var data = JSON.parse(jqXHR.responseText);
                console.log(data);
                $("#div_spinner_" + contacts_info_id).css('display', 'none');
                $("#div_edit_" + contacts_info_id).css('display', '');
                alert(data.error);
            });
        }
    }
</script>

<script>
    $("#datatable_data").DataTable({
        data: data,
        dom: "Blfrtip",
        "autoWidth": false,
        buttons: [
            {
                extend: "copy",
                className: "btn-sm"
            },
            {
                extend: "csv",
                className: "btn-sm"
            },
            {
                extend: "excel",
                className: "btn-sm"
            },
            {
                extend: "pdfHtml5",
                className: "btn-sm"
            },
            {
                extend: "print",
                className: "btn-sm"
            },
        ],
        responsive: true,
        'order': [[0, 'asc']]
    });
</script>