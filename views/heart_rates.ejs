<!DOCTYPE html>
<html>
    <head>
    <title>UTSW TBI Care</title>
    <meta charset="utf-8">
    <%- include('partials/header.ejs') %>
    <%- include('partials/table.ejs') %>
    <style>
    .mybutton {
        background-color: Transparent;
        background-repeat:no-repeat;
        border: none;
        cursor:pointer;
        overflow: hidden;
        outline:none;
    }
    </style>
    
    <style>
        @media screen and (max-width: 1000px) {
            #div_filter {
                height: 380px;
            }
        }
    
        @media screen and (min-width: 1000px) {
            #div_filter {
                height: 130px;
            }
        }
    </style>
    <script src="/public/js/authentication.js"></script>

    </head>
<body>

<%- include('partials/nav_dashboard.ejs') %>
<%- include('partials/sidebar.ejs') %>
<div id="content"  style="background-color:rgb(233, 231, 231);">
    <div id="mytable" class="col-12 mx-5 form my-5" style="background-color:white;">
  <h1 class="font-family: 'Merriweather', serif;
   text-center">View Heart Rates</h1>
  <hr>


<div class="container">
    <div id="div_filter" class="jumbotron" style="padding:20px 5px 60px 5px; height:205px">
        <form action="/website/heart_rates" method="GET">
            <div class="row">
            <div class="form-group col-md-4 col-xs-12">
                <label class="col-md-5 col-xs-12">Patient</label>
                <div class="col-md-7 col-xs-12">
                    <select name="patient_id" id="patient_id" class="form-control">
                        <option value="all" <%= locals.patient_id && locals.patient_id == 'all' ? 'selected' : '' %>>
                            All
                        </option>
                        <% for(var i = 0; i < patients.length; ++i) { %>
                        <option value="<%= patients[i].id %>"
                            <%= locals.patient_id && locals.patient_id == patients[i].id ? 'selected' : '' %>>
                            <%= patients[i].name %>
                        </option> <% } %>
                    </select>
                </div>
            </div>
            <div class="form-group col-md-4 col-xs-12">
                <label class="col-md-5 col-xs-12">Activity</label>
                <div class="col-md-7 col-xs-12">
                    <select name="activity_id" id="activity_id" class="form-control">
                        <option value="all" <%= locals.activity_id && locals.activity_id == 'all' ? 'selected' : '' %>>
                            All
                        </option>
                        <% for(var i = 0; i < activities.length; ++i) { %>
                        <option value="<%= activities[i].id %>"
                            <%= locals.activity_id && locals.activity_id == activities[i].id ? 'selected' : '' %>>
                            <%= activities[i].id %> | <%= activities[i].title %>
                        </option> <% } %>
                    </select>
                </div>
            </div>
            <div class="form-group col-md-4 col-xs-12">
                <label class="col-md-5 col-xs-12">Event ID</label>
                <div class="col-md-7 col-xs-12">
                    <select name="event_id" id="event_id" class="form-control">
                        <option value="all" <%= locals.event_id && locals.event_id == 'all' ? 'selected' : '' %>>
                            All
                        </option>
                        <% for(var i = 0; i < events.length; ++i) { %>
                        <option value="<%= events[i].id %>"
                            <%= locals.event_id && locals.event_id == events[i].id ? 'selected' : '' %>>
                            <%= events[i].id %>
                        </option> <% } %>
                    </select>
                </div>
            </div>
            <div class="form-group col-md-4 col-xs-12">
                <label class="col-md-5 col-xs-12">Attempt ID</label>
                <div class="col-md-7 col-xs-12">
                    <select name="attempt_id" id="attempt_id" class="form-control">
                        <option value="all" <%= locals.attempt_id && locals.attempt_id == 'all' ? 'selected' : '' %>>
                            All
                        </option>
                        <% for(var i = 0; i < attempts.length; ++i) { %>
                        <option value="<%= attempts[i].id %>"
                            <%= locals.attempt_id && locals.attempt_id == attempts[i].id ? 'selected' : '' %>>
                            <%= attempts[i].id %>
                        </option> <% } %>
                    </select>
                </div>
            </div>
            <div class="form-group col-md-2 col-xs-12" style='margin-left: 1.9%; margin-top: 3%;'>
                <input type="submit" name="filter" id="filter" value="Filter"
                    class="col-md-12 col-xs-12 btn btn-primary">
            </div>
        </div>
        </form>
    </div>
</div>

<div class="clearfix"></div>
<br>

<div style="text-align:center; width: 100%;">
    <div class="clearfix"></div>
    <br>
    <div class="table-responsive">
        <table id="datatable_data" class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Patient</th>
                    <th>Activity</th>
                    <th>Event</th>
                    <th>Attempt ID</th>
                    <th>Heart Rate Value</th>
                    <th>Recorded At</th>
                    <th>Created At</th>
                </tr>
            </thead>
            <tbody>

            </tbody>
            <tfoot>
                <tr>
                    <th>ID</th>
                    <th>Patient</th>
                    <th>Activity</th>
                    <th>Event</th>
                    <th>Attempt ID</th>
                    <th>Heart Rate Value</th>
                    <th>Recorded At</th>
                    <th>Created At</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<% include ./styles_import %>



<script>
    var data = [];
</script>

<% for (var i = 0; i < locals.results.length; ++i) { %>
<script>
    var row = [];
    row.push('<%= results[i].id %>');
    row.push('<%= results[i].patient_name %>');
    row.push('<%= results[i].activity_id %> | <%= results[i].activity_title %>');
    row.push(`
        <b>Event ID: </b><%= results[i].event_id %><br/>
        <b>Number Of Days Since Start: </b><%= results[i].event_number_of_days_since_start %><br/>
        <b>Occurrence Index Of Day: </b><%= results[i].event_occurrence_index_of_day %><br/>
        <b>State: </b><%= results[i].activity_id %>
    `);
    row.push('<%= results[i].attempt_id %>');
    row.push('<%= results[i].value %>');
    row.push('<%= results[i].recorded_at %>');
    row.push('<%= results[i].created_at %>');
    data.push(row);
</script>
<% } %>

<script>
    $("#datatable_data").DataTable({
        data: data,
        dom: "Blfrtip",
        "autoWidth": false,
        buttons: [
            {
                extend: "copy",
                className: "btn-sm"
            },
            {
                extend: "csv",
                className: "btn-sm"
            },
            {
                extend: "excel",
                className: "btn-sm"
            },
            {
                extend: "pdfHtml5",
                className: "btn-sm"
            },
            {
                extend: "print",
                className: "btn-sm"
            },
        ],
        responsive: true,
        'order': [[0, 'asc']]
    });
</script>
<%- include('partials/footer.ejs') %>
</body>
</html>