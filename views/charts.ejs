<script>
    function shuffleArray(array) {
        for (var i = array.length - 1; i > 0; i--) {
            var j = Math.floor(Math.random() * (i + 1));
            var temp = array[i];
            array[i] = array[j];
            array[j] = temp;
        }
    }
</script>

<script>
    var x_label = [];
    for (var i = 0; i < '<%= max_heart_rate_count %>'; ++i) {
        x_label.push(i + 1);
    }

    datasets = [];
    var color_index = 0;
    var colorNames = Object.keys(window.chartColors);
    console.log(colorNames);
    shuffleArray(colorNames);
</script>

<% for(var i = 0; i < chart_attempts.length; ++i) { %>
<% if(chart_attempts[i].heart_rates_array.length == 0) continue; %>
<script>
    var colorName = colorNames[color_index++ % colorNames.length];
    var newColor = window.chartColors[colorName];
    var heart_rates = [<%= chart_attempts[i].heart_rates_array %>];
    datasets.push({
        label: 'Attempt ' + '<%= (i + 1) %> (ID: <%= chart_attempts[i].id %>, Count: <%= chart_attempts[i].heart_rates_array.length %>)',
        backgroundColor: newColor,
        borderColor: newColor,
        data: heart_rates,
        fill: false,
    })
</script>
<% } %>

