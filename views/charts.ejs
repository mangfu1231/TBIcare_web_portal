<% include ./header %>

<style>
    @media screen and (max-width: 1000px) {
        #div_filter {
            height: 430px;
        }
    }

    @media screen and (min-width: 1000px) {
        #div_filter {
            height: 230px;
        }
    }

    canvas {
        -moz-user-select: none;
        -webkit-user-select: none;
        -ms-user-select: none;
    }
</style>

<div class="container">
    <div id="div_filter" class="jumbotron" style="padding:20px 5px 60px 5px;">
        <form action="/website/charts/patient" method="GET">
            <div class="form-group col-md-4 col-xs-12">
                <label class="col-md-5 col-xs-12">Patient</label>
                <div class="col-md-7 col-xs-12">
                    <select name="patient_id" id="patient_id" class="form-control" onchange="digest()">
                        <% for(var i = 0; i < locals.all_patients.length; ++i) { %>
                        <option value="<%= locals.all_patients[i].id %>"
                            <%= locals.patient_id && locals.patient_id == locals.all_patients[i].id ? 'selected' : '' %>>
                            <%= locals.all_patients[i].id %> | <%= locals.all_patients[i].name %>
                        </option>
                        <% } %>
                    </select>
                </div>
            </div>
            <div class="form-group col-md-4 col-xs-12">
                <label class="col-md-5 col-xs-12">Activity <small>(ID, Title)</small></label>
                <div class="col-md-7 col-xs-12">
                    <select name="activity_id" id="activity_id" class="form-control" onchange="digest('activity')">
                        <option value="all">All</option>
                        <% for(var i = 0; i < locals.all_activities.length; ++i) { %>
                        <% if(locals.all_activities[i].patient_id != locals.patient_id) continue; %>
                        <option value="<%= locals.all_activities[i].id %>"
                            <%= locals.activity_id && locals.activity_id == locals.all_activities[i].id ? 'selected' : '' %>>
                            <%= locals.all_activities[i].id %> | <%= locals.all_activities[i].title %>
                        </option>
                        <% } %>
                    </select>
                </div>
            </div>
            <div class="form-group col-md-4 col-xs-12">
                <label class="col-md-5 col-xs-12">Event <small>(ID, Number of Days Since Start, Occurrence Index of Day,
                        State)</small></label>
                <div class="col-md-7 col-xs-12">
                    <select name="event_id" id="event_id" class="form-control" onchange="digest('event')">
                        <option value="all">All</option>
                        <% for(var i = 0; i < locals.all_events.length; ++i) { %>
                        <% if(locals.all_events[i].patient_id != locals.patient_id) continue; %>
                        <% if(locals.activity_id != 'all' && locals.all_events[i].activity_id != locals.activity_id) continue; %>
                        <option value="<%= locals.all_events[i].id %>"
                            <%= locals.event_id && locals.event_id == locals.all_events[i].id ? 'selected' : '' %>>
                            <%= locals.all_events[i].id %> | <%= locals.all_events[i].number_of_days_since_start %>
                            | <%= locals.all_events[i].occurrence_index_of_day %> | <%= locals.all_events[i].state %>
                        </option>
                        <% } %>
                    </select>
                </div>
            </div>
            <div class="form-group col-md-4 col-xs-12">
                <label class="col-md-5 col-xs-12">Attempts</label>
                <div class="col-md-7 col-xs-12">
                    <select name="attempts" id="attempts" class="form-control" multiple>
                        <% for(var i = 0; i < locals.all_attempts.length; ++i) { %>
                        <% if(locals.activity_id != 'all' && locals.all_attempts[i].activity_id != locals.activity_id) continue; %>
                        <% if(locals.event_id != 'all' && locals.all_attempts[i].event_id != locals.event_id) continue; %>
                        <% if(locals.all_attempts[i].patient_id != locals.patient_id) continue; %>
                        <option value="<%= locals.all_attempts[i].id %>"
                            <%= locals.attempts && locals.attempts.indexOf(locals.all_attempts[i].id + '') != -1 ? 'selected' : '' %>>
                            <%= locals.all_attempts[i].id %>
                        </option>
                        <% } %>
                    </select>
                </div>
            </div>
            <div class="form-group col-md-2 col-xs-12">
                <input type="submit" name="filter" id="filter" value="Filter"
                    class="col-md-12 col-xs-12 btn btn-primary">
            </div>
        </form>
    </div>
</div>

<div class="clearfix"></div>
<br>

<% include ./styles_import %>

<script>
    function digest(except) {
        var patient_id = $("#patient_id").val();
        var activity_id = $("#activity_id").val();
        var event_id = $("#event_id").val();
        console.log('patient_id: ', patient_id);
        console.log('activity_id: ', activity_id);
        console.log('event_id: ', event_id);

        if (except != 'activity' && except != 'event') {
            $("#activity_id").find('option').remove().end();
            $("#activity_id").append(`<option value='all'>All</option>`)
            '<% for (var i = 0; i < locals.all_activities.length; ++i) { %>'
            if (patient_id == '<%= locals.all_activities[i].patient_id %>') {
                $("#activity_id").append(`
                    <option value='<%= locals.all_activities[i].id %>'> 
                        <%= locals.all_activities[i].id %>
                    </option>
                `);
            }
            console.log('<%= locals.all_activities[i].patient_id %>');
            '<% } %>'
        }

        if (except != 'event') {
            $("#event_id").find('option').remove().end();
            $("#event_id").append(`<option value='all'>All</option>`)
            '<% for (var i = 0; i < locals.all_events.length; ++i) { %>'
            if (patient_id == '<%= locals.all_events[i].patient_id %>' && (activity_id == 'all' || activity_id == '<%= locals.all_events[i].activity_id %>')) {
                $("#event_id").append(`
                    <option value='<%= locals.all_events[i].id %>'> 
                        <%= locals.all_events[i].id %> | <%= locals.all_events[i].number_of_days_since_start %>
                            | <%= locals.all_events[i].occurrence_index_of_day %> | <%= locals.all_events[i].state %>
                    </option>
                `);
            }
            console.log('<%= locals.all_events[i].patient_id %>');
            '<% } %>'
        }

        $("#attempts").find('option').remove().end();
        '<% for (var i = 0; i < locals.all_attempts.length; ++i) { %>'
        if (patient_id == '<%= locals.all_attempts[i].patient_id %>'
            && (activity_id == 'all' || activity_id == '<%= locals.all_attempts[i].activity_id %>')
            && (event_id == 'all' || event_id == '<%= locals.all_attempts[i].event_id %>')) {
            $("#attempts").append(`
                <option value='<%= locals.all_attempts[i].id %>'> 
                    <%= locals.all_attempts[i].id %>
                </option>
            `);
        }
        console.log('<%= locals.all_attempts[i].patient_id %>');
        '<% } %>'
    }

</script>

