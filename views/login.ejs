<!DOCTYPE html>
<html>
    <head>
    <title>UTSW TBI Care</title>
    <meta charset="utf-8">
    <%- include('partials/header.ejs') %>
    <script src="/public/js/login.js"></script>
    </head>
<body>
<%- include('partials/nav.ejs') %>


<div style="background-image: url(/assets/images/background.jpg); background-repeat: no-repeat; position: relative;
background-size: cover; width: 100%; height: 100%;">
    <div style="position: absolute; top: 15%; left: 35%; width:30%; height:35%;">
        <!-- form start here -->
        <form class="text-white" id="myForm" method="POST" action="/website/login" >
            <h1 class="text-center">UTSW TBI Care Login</h1>
            <br>
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>" />
            <div class="form-group">
                <label for="username"><strong>User Name</strong></label>
                <input type="text" name="username" class="form-control" placeholder="Username" id="username" />
            </div>
            <div class="form-group">
                <label for="password"><strong>Password</strong>
                    </label>
                <input type="password" name="password" class="form-control" placeholder="Password" id="password" />
            </div>
            <br>
            <input type="button" class="btn btn-info btn-block" value="login" onclick="login()"/>

<!--             <button type="submit" class="btn btn-info btn-block" >Login</button>
 -->            <div class="clearfix"></div>
            <% if(locals.error) { %>
            <div class="form-group alert alert-danger text-center" role="alert">
                <%= locals.error %>
            </div>
            <% } %>
            <br>
            <!-- <div style="text-align:center; "><a style="color:white;" href="/website/register"><strong><u>Create a Account</u></strong></a></div> -->
        </form>
    </div>
<!-- close background picture -->
</div>
</body>
</html>