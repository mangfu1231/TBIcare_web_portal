<body>



    <nav class="navbar navbar-fixed-top navbar-inverse">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbar"
                    aria-expanded="false" aria-controls="navbar">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a class="navbar-brand" href="/website/dashboard">TBI Care</a>
            </div>
            <div id="navbar" class="collapse navbar-collapse">
                <ul class="nav navbar-nav pull-left">
                    <!-- <li class="<%= (locals.home_active ? 'active' : '') %>"><a href="#">Home</a></li> -->
                    <!-- <li><a href="#about">About</a></li> -->
                    <!-- <li><a href="#contact">Contact</a></li> -->
                    <li class="dropdown"><a class="dropdown-toggle" data-toggle="dropdown" href="#">Forms <span
                                class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li><a href="/website/admins">Admins</a></li>
                            <li><a href="/website/patients">Patients</a></li>
                            <li><a href="/website/activities">Activities</a></li>
                            <li><a href="/website/schedules">Schedules</a></li>
                            <li><a href="/website/events">Events</a></li>
                            <li><a href="/website/attempts">Attempts</a></li>
                            <li><a href="/website/heart_rates">Heart Rates</a></li>
                            <li><a href="/website/heart_rate_variability">Heart Rate Variablity</a></li>
                            <li><a href="/website/vo2_max">VO2 Max</a></li>
                            <li><a href="/website/contacts">Care Team Contacts</a></li>
                        </ul>
                    </li>
                    <li><a href="/website/pushNotifications">Push Notifications</a></li>
                </ul>
                <ul class="nav navbar-nav pull-right">
                    <li id="logout"><a>Logout</a></li>
                </ul>
            </div><!-- /.nav-collapse -->
        </div><!-- /.container -->
    </nav><!-- /.navbar -->

    <!-- Bootstrap core JavaScript
    ================================================== -->
    <!-- Placed at the end of the document so the pages load faster -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.12.4/jquery.min.js"></script>
    <script>window.jQuery || document.write('<script src="/javascripts/vendor/jquery.min.js"><\/script>')</script>
    <!-- IE10 viewport hack for Surface/desktop Windows 8 bug -->
    <script src="/javascripts/ie10-viewport-bug-workaround.js"></script>
    <script src="/javascripts/offcanvas.js"></script>

    <script>
        $("#logout").click(function () {
            $.ajax({
                headers: { "x-csrf-token": "<%= locals.csrfToken %>" },
                url: '/website/logout',
                type: 'POST'
            }).done(function (response) {
                console.log(response);
                responseObj = JSON.parse(response);
                if (responseObj.success) {
                    location.reload('/');
                    console.log("hello");
                }
                else {
                    alert('something went wrong');
                }
            });
        });

        $(document).ready(function () {
            $.ajax({
                headers: { "x-csrf-token": "<%= locals.csrfToken %>" },
                url: '/website/report/inactive_patients/count',
                type: 'POST'
            }).done(function (response) {
                if (response.success) {
                    var count = response.inactive_patients_count;
                    if (count) {
                        $("#badge").css('display', '');
                        $("#badge").html(count);
                    }
                }
            });
        });
    </script>

</body>

</html>